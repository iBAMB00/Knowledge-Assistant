APP_NAME=Knowledge Assistant AI Agent
DEBUG=False
LOG_LEVEL=INFO

# ==========================
# LLM
# ==========================
MODEL_PROVIDER=$MODEL_PROVIDER

MODEL_NAME=$MODEL_NAME

MODEL_BASE_URL=$MODEL_BASE_URL

MODEL_API_KEY=$MODEL_API_KEY


# ==========================
# Embedding
# ==========================
EMBEDDING_PROVIDER=$EMBEDDING_PROVIDER

EMBEDDING_BASE_URL=$EMBEDDING_BASE_URL

EMBEDDING_MODEL=$EMBEDDING_MODEL

EMBEDDING_API_KEY=$EMBEDDING_API_KEY

EMBEDDING_DIMENSION=$EMBEDDING_DIMENSION


# ==========================
# Chunk
# ==========================
CHUNK_STRATEGY=recursive_character

CHUNK_SIZE=600

CHUNK_OVERLAP=100

# Parent-Child：保留600/100父Chunk作为Dense Baseline，子Chunk负责细粒度召回。
PARENT_CHILD_ENABLED=True
PARENT_CHILD_CHILD_SIZE=300
PARENT_CHILD_CHILD_OVERLAP=50


# ==========================
# Retrieval
# ==========================
RETRIEVAL_TOP_K=5

RETRIEVAL_CANDIDATE_K=20

RETRIEVAL_SCORE_THRESHOLD=-1.0      # 调试检索和离线评估默认不过滤低分结果，便于观察完整的相似度分布。

RETRIEVAL_PER_DOCUMENT_LIMIT=2

# Hybrid：Dense(Qdrant) + BM25(PostgreSQL) 使用 RRF 融合。
RETRIEVAL_HYBRID_ENABLED=True
RETRIEVAL_RRF_K=60

# Reranker 默认关闭，配置好百炼 Workspace rerank endpoint 后再开启。
RERANKER_ENABLED=False
RERANKER_PROVIDER=bailian
RERANKER_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RERANKER_MODEL=qwen3-rerank
RERANKER_API_KEY=your_reranker_api_key
RERANKER_TIMEOUT=30
RERANKER_FAIL_OPEN=True
# 默认留空时使用模型的问答检索策略。
RERANKER_INSTRUCT=

KNOWLEDGE_CHAT_SCORE_THRESHOLD=0.40 # 正式知识问答的最低相似度阈值。


# ==========================
# Vector Store
# ==========================

VECTOR_STORE_BACKEND=database

QDRANT_URL=http://127.0.0.1:6333

QDRANT_API_KEY=

QDRANT_COLLECTION_NAME=knowledge_assistant_chunks

QDRANT_TIMEOUT=10
# ==========================
# Database / Redis / Celery
# ==========================
# 本机开发仍可使用 SQLite；Docker Compose 会覆盖为 PostgreSQL。
DATABASE_URL=sqlite:///./knowledge_assistant.db
TEST_DATABASE_URL=sqlite:///./test.db
DATABASE_POOL_PRE_PING=True
DATABASE_POOL_RECYCLE=1800

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True
CELERY_VISIBILITY_TIMEOUT=3600

# ProcessingJob Worker 可靠性。
PROCESSING_JOB_MAX_RETRIES=3
PROCESSING_JOB_RETRY_BASE_DELAY=2
PROCESSING_JOB_RETRY_MAX_DELAY=30
PROCESSING_JOB_LEASE_SECONDS=900

# Docker Compose PostgreSQL 初始化参数。
POSTGRES_DB=knowledge_assistant
POSTGRES_USER=knowledge_assistant
POSTGRES_PASSWORD=knowledge_assistant_dev
